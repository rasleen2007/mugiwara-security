# Mugiwara Security - environment template (copy to .env; NEVER commit .env).
#
# SECURITY CONTRACT
# -----------------
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security. It may ONLY be set in
# the server-side environments that run mugiwara-cloud api / worker processes.
# It must NEVER be:
#   - committed to git,
#   - prefixed with NEXT_PUBLIC_/VITE_/REACT_APP_ (browser-exposed),
#   - placed in any Vercel "exposed to browser" environment variable,
#   - sent from or logged by frontend code.
# Browser code receives ONLY the URL + publishable anon key below.

# --- Server-side only (FastAPI API + Python worker) -------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # SERVER-SIDE ONLY (see above)
SUPABASE_JWKS_URL=                    # optional override; default: <SUPABASE_URL>/auth/v1/.well-known/jwks.json
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Object storage buckets created by supabase/migrations/0003_storage.sql
MUGIWARA_UPLOAD_BUCKET=scan-uploads
MUGIWARA_EXPORT_BUCKET=report-exports

# --- Hosted web app (Vercel) ------------------------------------------------
# Only these two values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the FastAPI service the web app calls with Bearer tokens.
NEXT_PUBLIC_MUGIWARA_API_URL=http://localhost:8000
