# Mugiwara SaaS Dashboard — environment variables
#
# SECURITY CONTRACT
# ─────────────────
# Only the three NEXT_PUBLIC_* variables below are exposed to the browser.
# All other secrets (SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, worker keys)
# must NEVER be placed in NEXT_PUBLIC_* variables or in dashboard source code.
#
# Copy this file to .env.local (never commit .env.local).

# ── Browser-visible (Next.js static inlining) ─────────────────────────────
# The Supabase project URL. Must NOT have a trailing slash.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# The Supabase publishable/anon key (safe for browsers).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The Mugiwara cloud API base URL (FastAPI service).
# Development default; override for staging/production.
NEXT_PUBLIC_MUGIWARA_API_URL=http://localhost:8000
